//! {{display_name}} -- generated by `plugin_sdk::generator` from this
//! workspace's plugin template (Development_plan Phase 29, Plugins.md
//! SS8/SS9). Implements the real `plugin_manager::Plugin` trait, the
//! one extension mechanism this workspace's `PluginManager` actually
//! runs code through -- not the separate, deliberately narrower
//! `dlopen`-based `.so` loader (`plugin_manager::dynamic`), which only
//! ever exposes plugin name/version, never tools. See
//! `plugin_manager::plugin`'s own module docs for why the two are kept
//! separate.
//!
//! To wire this plugin in: build a `{{struct_name}}` (it implements
//! `Default`), and hand it to `PluginManager::register` alongside a
//! `PluginManifest` loaded from this crate's `manifest.toml` (or its
//! own hard-coded equivalent) -- the same two-part registration every
//! test in `plugin_manager::manager` already exercises.

use common::AppResult;
use plugin_manager::{Plugin, PluginMetadata};
use std::sync::Arc;
use std::time::Duration;
use tool_framework::{InputSchema, ParamKind, ParamSchema, PermissionLevel, Tool, ToolArgs, ToolCategory, ToolOutcome};

#[derive(Default)]
pub struct {{struct_name}};

impl Plugin for {{struct_name}} {
    fn metadata(&self) -> PluginMetadata {
        PluginMetadata {
            id: "{{id}}".to_string(),
            name: "{{display_name}}".to_string(),
            version: env!("CARGO_PKG_VERSION").to_string(),
        }
    }

    fn initialize(&mut self) -> AppResult<()> {
        Ok(())
    }

    fn shutdown(&mut self) -> AppResult<()> {
        Ok(())
    }

    fn register_tools(&self) -> Vec<Arc<dyn Tool>> {
        vec![Arc::new({{tool_struct_name}})]
    }
}

/// {{tool_description}}
///
/// A starting point, not a finished tool: replace `execute`'s body
/// with real logic, and `input_schema`'s params with whatever this
/// tool actually needs -- `ParamKind` also has an `Any` variant
/// (accepts arbitrary JSON) for a parameter too irregular to model with
/// the closed String/Integer/Float/Bool/StringArray set, see
/// `tool_framework::schema`'s own module docs.
pub struct {{tool_struct_name}};

impl Tool for {{tool_struct_name}} {
    fn name(&self) -> &str {
        "{{tool_name}}"
    }

    fn description(&self) -> &str {
        "{{tool_description}}"
    }

    fn category(&self) -> ToolCategory {
        ToolCategory::System
    }

    fn permission_level(&self) -> PermissionLevel {
        PermissionLevel::{{permission_level}}
    }

    fn timeout(&self) -> Duration {
        Duration::from_secs(5)
    }

    fn input_schema(&self) -> InputSchema {
        InputSchema::new(vec![ParamSchema::required("text", ParamKind::String)])
    }

    fn execute(&self, args: &ToolArgs) -> ToolOutcome {
        let text = args.get("text").and_then(|v| v.as_str()).unwrap_or_default();
        ToolOutcome {
            success: true,
            message: format!("{{tool_name}}: {text}"),
            data: Some(serde_json::json!({ "text": text })),
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn plugin_reports_the_declared_metadata() {
        let plugin = {{struct_name}};
        let meta = plugin.metadata();
        assert_eq!(meta.id, "{{id}}");
    }

    #[test]
    fn the_tool_executes_and_echoes_its_input() {
        let tool = {{tool_struct_name}};
        let mut args = ToolArgs::new();
        args.insert("text".to_string(), serde_json::json!("hello"));
        let outcome = tool.execute(&args);
        assert!(outcome.success);
        assert!(outcome.message.contains("hello"));
    }
}
